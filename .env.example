# =============================================================================
# Sunday Strikers - environment configuration
# Copy this file to .env.local and fill in real values.
# =============================================================================

# Supabase project settings (used by the app AND the QA/Playwright suite)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: service-role key. Bypasses RLS. ONLY needed for the QA suite to
# seed isolated data directly and to hard-delete cleanup (Playwright only).
# NEVER expose this key in client-side code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin credentials used by the Playwright authenticated-admin fixture.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Base URL the Playwright suite runs against.
QA_BASE_URL=http://localhost:5173
